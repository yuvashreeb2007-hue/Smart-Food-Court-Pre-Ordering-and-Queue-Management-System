{
  "name": "smart-food-court",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Food Court — Pre-Ordering and Queue Management System",
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "test:server": "npm --prefix server run test",
    "db:check": "npm --prefix server run db:check"
  }
}
